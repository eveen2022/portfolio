# Email sending — choose one provider
# console = logs the email to the server console instead of sending (safe default, no signup needed)
# resend  = send via https://resend.com (recommended, simple API + free tier)
# smtp    = send via any SMTP server (e.g. Gmail with an App Password)
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
CONTACT_TO_EMAIL=your-email@example.com

# Required when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Site
SITE_URL=http://localhost:3001

# MongoDB — connection string for the app's data store (projects, posts,
# skills, experience, education, site settings, messages, activity log,
# analytics, admin credentials, blog post bodies).
# For Vercel: use a MongoDB Atlas connection string (mongodb+srv://...) and
# add it as an Environment Variable in the Vercel project settings.
MONGODB_URI=
MONGODB_DB=portfolio

# Admin panel (/admin) — change these before deploying.
# ADMIN_PASSWORD is only the initial/fallback password. Once you change it from
# /admin/settings, the new (hashed) password is stored in MongoDB and takes
# priority over this value.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-random-32+-character-string

# Only set this to "true" if the app is deployed behind something that sets
# X-Forwarded-For authoritatively (Vercel, or a reverse proxy you've
# configured to overwrite rather than append to it). Rate limiting (login,
# 2FA, recovery PIN, uploads) is keyed on the client IP this reports — if
# nothing in front of the app can be trusted to set it correctly, leave this
# unset/false, since a client can otherwise fake a fresh IP on every request
# and bypass rate limiting entirely.
TRUST_PROXY_HEADERS=false
